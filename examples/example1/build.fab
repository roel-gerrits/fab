

toolchain = load("tools.fab").toolchain

includes = [
    path("."),
    path("liba"),
    # filter_dir(path("."), "*.h")
    # dir(".", filter="*.h")
]

sources = [
    path("main.cpp"),
    path("lib.cpp"),
    path("liba/liba.cpp"),
]

objs = [toolchain.compile(src, includes=includes) for src in sources]
exe = toolchain.link("main", objs)


compile_commands = link(gcc_collect_compile_commands(exe))

tool = containerized_tool(
    "image",
    "some_tool <arg1> <arg2>",
)
